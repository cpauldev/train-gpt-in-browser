{
  "name": "train-gpt-in-browser",
  "productName": "Train GPT in Browser",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "desktop:pack": "bun run build && electron-builder --dir",
    "desktop:dist": "bun run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --config-path ./biome.json --css-parse-tailwind-directives=true ./src ./index.html ./package.json ./tsconfig.json ./tsconfig.node.json ./components.json ./vite.config.ts",
    "lint:md": "markdownlint-cli2 --config ./.markdownlint-cli2.jsonc",
    "lint:unused": "bun run lint:unused:project",
    "lint:unused:project": "knip --production --include files,dependencies,unlisted",
    "lint:unused:exports": "knip --include exports,types",
    "lint:unused:fix": "knip --production --include exports --fix",
    "format": "biome format --config-path ./biome.json --css-parse-tailwind-directives=true --write ./src ./index.html ./package.json ./tsconfig.json ./tsconfig.node.json ./components.json ./vite.config.ts",
    "format:check": "biome format --config-path ./biome.json --css-parse-tailwind-directives=true ./src ./index.html ./package.json ./tsconfig.json ./tsconfig.node.json ./components.json ./vite.config.ts",
    "check": "biome check --config-path ./biome.json --css-parse-tailwind-directives=true ./src ./index.html ./package.json ./tsconfig.json ./tsconfig.node.json ./components.json ./vite.config.ts",
    "check:write": "biome check --config-path ./biome.json --css-parse-tailwind-directives=true --write ./src ./index.html ./package.json ./tsconfig.json ./tsconfig.node.json ./components.json ./vite.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "validate": "bun run check && bun run lint:md && bun run typecheck && bun run test:run && bun run lint:unused && bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html}": [
      "biome check --config-path ./biome.json --css-parse-tailwind-directives=true --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2 --config ./.markdownlint-cli2.jsonc --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@fontsource-variable/manrope": "^5.2.8",
    "@noble/hashes": "^2.2.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "liveline": "^0.0.7",
    "long": "^5.3.2",
    "lucide-react": "^1.22.0",
    "onnx-proto": "^8.0.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.23.0",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "dev.cpaul.train-gpt-in-browser",
    "productName": "Train GPT in Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "public/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "public/favicon.svg",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "public/favicon.svg",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  }
}
